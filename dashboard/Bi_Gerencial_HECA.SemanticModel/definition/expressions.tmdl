expression 'BD COMPROMISSADO' = ```
		let
		    // --- STEP 1: Get the Metadata (Date) and Content from the Folder ---
		    FolderPath = "G:\Meu Drive\Info_enterprise\externo\HECA\",
		    FileName = "Banco de Dados Gerencial - Set_2025.xlsx",
		    
		    // Connect to folder
		    SourceFolder = Folder.Files(FolderPath),
		    
		    // Filter for the specific file
		    FilteredRow = Table.SelectRows(SourceFolder, each [Name] = FileName),
		    
		    // Extract the "Date created" into a variable to use later
		    SourceDateCreated = FilteredRow{0}[Date created],
		    
		    // Extract the Binary content to open the Excel file
		    FileContent = FilteredRow{0}[Content],
		
		    // --- STEP 2: Open the Excel (Replaces your original "Source") ---
		    Source = Excel.Workbook(FileContent, null, true),
		    
		    // --- STEP 3: Your Original Transformations ---
		    #"BD COMPROMISSADO_Sheet" = Source{[Item="BD COMPROMISSADO",Kind="Sheet"]}[Data],
		    #"Removed Columns" = Table.RemoveColumns(#"BD COMPROMISSADO_Sheet",{"Column1"}),
		    #"Removed Top Rows" = Table.Skip(#"Removed Columns",8),
		    #"Promoted Headers" = Table.PromoteHeaders(#"Removed Top Rows", [PromoteAllScalars=true]),
		    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"DT. RECTO", type date}, {"DT. #(lf)DOC", type date}, {"DT.#(lf)VENCORIG", type date}, {"DT.#(lf)MOVBANC", type date}, {"DT.#(lf)VENC", type date}, {"TOTATUALTXADMPREV", type number}, {"TOTATUALTXADMCOMP", type number}, {"TOTATUALTXADMEFETU", type number}, {"VALOR TOTAL EFETUADO", type number}, {"VALOR TOTAL PREVISTO", type number}, {"VALOR TOTAL COMP.", type number}}),
		    #"Filtered Rows" = Table.SelectRows(#"Changed Type", each ([CENTRO DE CUSTO] <> null)),
		    #"Filtered Rows1" = Table.SelectRows(#"Filtered Rows", each Text.StartsWith([PLANO DE CONTA], "1") or Text.StartsWith([PLANO DE CONTA], "2")),
		    #"Replaced Value" = Table.ReplaceValue(#"Filtered Rows1",".","",Replacer.ReplaceText,{"PLANO DE CONTA"}),
		    #"Ajuste de coluna" = Table.AddColumn(#"Replaced Value", "Receita/Despesa", each if [PLANO DE CONTA] = "1001020001" then "Receita" else if [PLANO DE CONTA] = "1001020002" then "Receita" else if [PLANO DE CONTA] = "1001020003" then "Receita" else if [PLANO DE CONTA] = "1001030004" then "Receita" else if [PLANO DE CONTA] = "1001030005" then "Receita" else if [PLANO DE CONTA] = "1001020004" then "Receita" else if [PLANO DE CONTA] = "1001020005" then "Receita" else if [PLANO DE CONTA] = "1001020006" then "Receita" else if [PLANO DE CONTA] = "1001030001" then "Receita" else if [PLANO DE CONTA] = "1001030002" then "Receita" else if [PLANO DE CONTA] = "1001030003" then "Receita" else if [PLANO DE CONTA] = "1001030007" then "Receita" else if [PLANO DE CONTA] = "1001030008" then "Receita" else if [PLANO DE CONTA] = "1001040001" then "Receita" else if [PLANO DE CONTA] = "1001040002" then "Receita" else if [PLANO DE CONTA] = "1001040003" then "Receita" else if [PLANO DE CONTA] = "1004010001" then "Receita" else if [PLANO DE CONTA] = "1002010004" then "Receita" else if [PLANO DE CONTA] = "1004010002" then "Receita" else if [PLANO DE CONTA] = "1002010001" then "Receita" else if [PLANO DE CONTA] = "1001040004" then "Receita" else "Despesa"),
		    #"Renamed Columns" = Table.RenameColumns(#"Ajuste de coluna",{{"DT.#(lf)MOVBANC", "DT.MOVBANC"}, {"FORNECEDOR", "FORNECEDOR/CLIENTE"}, {"DESCRIÇÃO DA EMPRESA", "EMPRESA RECBTO/PAGTO"}}),
		    #"Duplicated Column" = Table.DuplicateColumn(#"Renamed Columns", "DT.#(lf)VENCORIG", "DT.#(lf)VENCORIG - Copy"),
		    #"Renamed Columns1" = Table.RenameColumns(#"Duplicated Column",{{"DT.#(lf)VENCORIG - Copy", "DT.Competencia"}}),
		
		    // --- STEP 4: Add the Date Created Column at the end ---
		    #"Added File Date" = Table.AddColumn(#"Renamed Columns1", "Source File Date", each SourceDateCreated, type datetime),
		    #"Renamed Columns2" = Table.RenameColumns(#"Added File Date",{{"Source File Date", "Data da Base"}}),
		    #"Added Custom" = Table.AddColumn(#"Renamed Columns2", "ETAPAOBRA", each 0),
		    #"Added Custom1" = Table.AddColumn(#"Added Custom", "REALIZADO_A_REALIZAR", each "A Realizar")
