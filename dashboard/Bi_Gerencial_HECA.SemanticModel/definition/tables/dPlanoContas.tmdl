		lineageTag: edf41202-bb6b-4ced-9ab1-64212efca28e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Hierarchy_L4 = ```
			
			VAR Codigo_Nivel4 = LEFT(dPlanoContas[COD_CONTA], 10) 
			VAR Nome_Nivel4 = LOOKUPVALUE(dPlanoContas[DESCRICAO], dPlanoContas[COD_CONTA], Codigo_Nivel4)
			RETURN 
			    IF(
			        LEN(dPlanoContas[COD_CONTA]) >= 10, 
			        Codigo_Nivel4 & " - " & Nome_Nivel4, 
			        BLANK()
			    )
			```
		lineageTag: d271bd91-c230-42f4-b51e-7980a322d9cc
