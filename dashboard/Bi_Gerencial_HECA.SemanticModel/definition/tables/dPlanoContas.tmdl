	column DESCRICAO
		lineageTag: 4a7f580b-04f9-4808-91f5-db14f3167881
		summarizeBy: none
		isNameInferred
		sourceColumn: [DESCRICAO]

		annotation SummarizationSetBy = Automatic

	column Hierarchy_L1 = ```
			
			VAR Codigo_Nivel1 = LEFT(dPlanoContas[COD_CONTA], 1)
			VAR Nome_Nivel1 = LOOKUPVALUE(dPlanoContas[DESCRICAO], dPlanoContas[COD_CONTA], Codigo_Nivel1)
			RETURN 
			    Codigo_Nivel1 & " - " & Nome_Nivel1
			```
		lineageTag: 67645053-130e-4863-8658-4780a541462c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Hierarchy_L2 = ```
			
			VAR Codigo_Nivel2 = LEFT(dPlanoContas[COD_CONTA], 4) -- Grabs 1.001
			VAR Nome_Nivel2 = LOOKUPVALUE(dPlanoContas[DESCRICAO], dPlanoContas[COD_CONTA], Codigo_Nivel2)
			RETURN 
			    IF(
			        LEN(dPlanoContas[COD_CONTA]) >= 4, 
			        Codigo_Nivel2 & " - " & Nome_Nivel2, 
			        BLANK()
			    )
			```
		lineageTag: 9d4bbd2d-324b-43eb-809c-44310fd3c1f7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Hierarchy_L3 = ```
			
			VAR Codigo_Nivel3 = LEFT(dPlanoContas[COD_CONTA], 6) -- Grabs 1.001.02
			VAR Nome_Nivel3 = LOOKUPVALUE(dPlanoContas[DESCRICAO], dPlanoContas[COD_CONTA], Codigo_Nivel3)
			RETURN 
			    IF(
			        LEN(dPlanoContas[COD_CONTA]) >= 6, 
			        Codigo_Nivel3 & " - " & Nome_Nivel3, 
			        BLANK()
			    )
