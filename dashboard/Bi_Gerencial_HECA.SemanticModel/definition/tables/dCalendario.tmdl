	partition dCalendario = m
		mode: import
		source = ```
				let
				// 1. configuration: Change 'BD EFETUADO' to your actual Fact Table name
				    Source = #"fct_gerencial",
				    
				    // 2. Identify the range of dates dynamically
				    ColDate = Source[DT.Competencia], 
				    MinDate = List.Min(ColDate),
				    MaxDate = List.Max(ColDate),
				
				    // 3. Set Start to Jan 1st of the first year, and End to Dec 31st of the last year
				    StartDate = #date(Date.Year(MinDate), 1, 1),
				    EndDate = #date(Date.Year(MaxDate), 12, 31),
				    
				    // 4. Create the list of dates
				    Duration = Duration.Days(EndDate - StartDate) + 1,
				    ListDates = List.Dates(StartDate, Duration, #duration(1, 0, 0, 0)),
				    
				    // 5. Convert to Table
				    #"Converted to Table" = Table.FromList(ListDates, Splitter.SplitByNothing(), null, null, ExtraValues.Error),
				    #"Renamed Columns" = Table.RenameColumns(#"Converted to Table",{{"Column1", "Date"}}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Renamed Columns",{{"Date", type date}}),
				
				    // 6. Add Calendar Columns (Best Practices)
				    #"Inserted Year" = Table.AddColumn(#"Changed Type", "Ano", each Date.Year([Date]), Int64.Type),
				    #"Inserted Month" = Table.AddColumn(#"Inserted Year", "Mes Num", each Date.Month([Date]), Int64.Type),
				    #"Inserted Month Name" = Table.AddColumn(#"Inserted Month", "Mes Nome", each Date.ToText([Date], "MMM", "pt-BR"), type text), // Short Name (Jan, Fev)
				    #"Inserted Quarter" = Table.AddColumn(#"Inserted Month Name", "Trimestre", each Date.QuarterOfYear([Date]), Int64.Type),
				    #"Inserted YearMonth" = Table.AddColumn(#"Inserted Quarter", "AnoMes", each [Ano] * 100 + [Mes Num], Int64.Type),
				    #"Inserted MonthYear" = Table.AddColumn(#"Inserted YearMonth", "MesAno", each Date.ToText(#date([Ano], [Mes Num], 1), "MM/yyyy"), type text), // Sort Key (e.g. 202401)
				    
				    // 7. Add Week and Day info (Optional but recommended)
				    #"Inserted Week" = Table.AddColumn(#"Inserted MonthYear", "Semana do Ano", each Date.WeekOfYear([Date]), Int64.Type),
				    #"Inserted DayWeek" = Table.AddColumn(#"Inserted Week", "Dia da Semana", each Date.DayOfWeek([Date]), Int64.Type),
				    #"Inserted DayName" = Table.AddColumn(#"Inserted DayWeek", "Nome do Dia", each Date.ToText([Date], "dddd", "pt-BR"), type text),
				    
				    // 8. Capitalize First Letters of names
				    #"Capitalized" = Table.TransformColumns(#"Inserted DayName",{{"Mes Nome", Text.Proper, type text}, {"Nome do Dia", Text.Proper, type text}})
				in
				    #"Capitalized"
				```

