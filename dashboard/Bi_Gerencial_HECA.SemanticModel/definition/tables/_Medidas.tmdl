	measure 'Transf Receita' = ```
			
			    CALCULATE(
			        SUM('dim_socio'[VALOR TOTAL EFETUADO]),
			        'dim_socio'[OP.] = "823"
			    )+0
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 2c1fccd0-fd62-4d4f-97c1-4d1beee44386

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'TAC paga' = ```
			
			VAR CalculoPagamento = 
			    CALCULATE(
			        SUM(fct_gerencial[VALOR TOTAL EFETUADO]),
			        // 1. Filter the specific Accounts in the FACT table
			        fct_gerencial[PLANO DE CONTA] IN {"2006030007", "2006030009"},
			        // 2. Ensure we calculate the total for the 'ID Socio'
			        ALLEXCEPT('CLASSIFICAÇÃO DAS OBRAS', 'CLASSIFICAÇÃO DAS OBRAS'[ID Socio])
			    )
			
			RETURN
			    // Only show the payment if Prevista has a value. 
			    // Otherwise return BLANK, which hides the row.
			    IF(
			        ISBLANK([Prevista]) || [Prevista] = 0,
			        BLANK(),
			        CalculoPagamento
			    )
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 4eb7c2cf-bd92-4efd-b80a-73e15fb965ec

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'TAC a pagar' =
			
			[Prevista] - [TAC paga]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: be2666c1-9606-443b-aba7-e8e7d3049ae9

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Receita Futura' =
			
			CALCULATE(
			        SUM(fct_gerencial[VALOR TOTAL EFETUADO]),
			        fct_gerencial[PLANO DE CONTA] IN {"1001020001", "1001020002"})
		lineageTag: 85209f3d-f967-4acd-a05e-07d92ec09cbe

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Prevista = ```
			
			SUMX(
			    'CLASSIFICAÇÃO DAS OBRAS',
			    VAR ReceitaDoSocio = 
			        CALCULATE(
			            [Receita Futura], 
			            /* This keeps the filter on 'ID Socio' but removes filters 
			               from Description and % TAC within this table */
			            ALLEXCEPT('CLASSIFICAÇÃO DAS OBRAS', 'CLASSIFICAÇÃO DAS OBRAS'[ID Socio])
			        )
			    RETURN 
			        ReceitaDoSocio * 'CLASSIFICAÇÃO DAS OBRAS'[% TAC]
			)
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: d6238c55-fe15-4284-a9fb-367861c11eaf

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Total tac' = [TAC a pagar] + [TAC paga]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 0d5c33f6-3bb8-403d-b7f3-91901936421b

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Verificação TAC' = ```
			
			VAR vPrevista = [Prevista]
			VAR vTotalTAC = [Total tac]
			VAR vDiferenca = vTotalTAC - vPrevista
			
			RETURN
			    IF(
			        // We check if the absolute difference is less than 1 cent to avoid rounding errors
			        ABS(vDiferenca) < 0.01, 
			        "Ok", 
			        "Não Conforme (" & FORMAT(vDiferenca, "R$ #,##0.00") & ")"
			    )
			```
		lineageTag: 245d58de-1b59-4cdf-9416-255f1e7c38b1

	measure 'Receitas Recebidas' =
			
			CALCULATE(
			    SUM('dim_socio'[VALOR TOTAL EFETUADO]),
			    'dim_socio'[OP.] = "510",
			
			    -- Aplica o sócio vindo da Classificação das Obras
			    TREATAS(
			        VALUES('CLASSIFICAÇÃO DAS OBRAS'[DESCRIÇÃO]),
			        'dim_socio'[EMPRESA RECBTO/PAGTO]
			    )
			) + 0
		lineageTag: 5ef34292-07f4-4e16-b7a0-0388489b21d4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

