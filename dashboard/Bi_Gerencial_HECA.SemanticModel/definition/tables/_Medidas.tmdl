	measure 'Aporte all companies' = ```
			
			    CALCULATE(
			    SUM('dim_socio'[VALOR TOTAL EFETUADO]),
			    'dim_socio'[OP.] IN { "723", "735", "736", "748" },
			    TREATAS(
			        VALUES('CLASSIFICAÇÃO DAS OBRAS'[DESCRIÇÃO]),
			        'dim_socio'[EMPRESA RECBTO/PAGTO]
			    )
			)+0
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Posição Societaria
		lineageTag: d40af63d-5023-41fd-a632-c03325505316

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure Devolução =
			
			VAR SocioAtual =
			    SELECTEDVALUE('CLASSIFICAÇÃO DAS OBRAS'[DESCRIÇÃO])
			RETURN
			CALCULATE(
			    SUM('dim_socio'[VALOR TOTAL EFETUADO]),
			    'dim_socio'[OP.] IN { "723", "735", "736", "748" },
			
			    -- Remove o filtro do lado do aporte
			    REMOVEFILTERS('dim_socio'[EMPRESA RECBTO/PAGTO]),
			
			    -- Aplica o sócio no papel de quem devolveu
			    'dim_socio'[FORNECEDOR/CLIENTE] = SocioAtual
			)
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Posição Societaria
		lineageTag: da62d5fd-dd6e-429c-aafc-ff76d39cfdf0

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Saldo de Aportes' = [Aporte all companies] - [Devolução]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Posição Societaria
		lineageTag: d3c7e492-4b96-4912-ab8e-1d2c4c00d065

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure %Faturado = ```
			
			
			 VAR servicos = CALCULATE(SUM(fct_gerencial[VALOR TOTAL EFETUADO]), fct_gerencial[PLANO DE CONTA] = "1001020001")
			
			 VAR reajustes = CALCULATE(SUM(fct_gerencial[VALOR TOTAL EFETUADO]), fct_gerencial[PLANO DE CONTA] = "1001020002")
			
			 VAR contratos = SUM(Gerencia[VALOR ATUAL DO CONTRATO])
			
			 RETURN
			
			 DIVIDE((servicos+reajustes),contratos,0)
			```
		lineageTag: 5a884bf2-eb0d-4445-a1b5-1a417561be53

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total acumulado receita' = [Saldo Efetuado] + [Saldo Compromissado]+0
		displayFolder: Posição Acumulada
		lineageTag: d9e1dedc-f4c8-4783-8d56-2bc055d531b4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure % = ```
			
			// 1. DEFINIR O NUMERADOR CORRETO PARA CADA LINHA
			VAR Numerador =
			    SWITCH (
			        TRUE (),
			        // Caso especial 1: Para a conta de Receita Diferida, use o valor de Competência
			        SELECTEDVALUE ( 'dPlanoContas'[COD_CONTA] ) = "1001020003", [Comp.],
			        // Caso especial 2: Para a conta de Faturas, use o valor Efetuado
			        SELECTEDVALUE ( 'dPlanoContas'[COD_CONTA] ) = "1001020001", [Valor Liquido Efetuado],
			        // Padrão: Para todas as outras linhas (incluindo totais), use o valor da própria linha
			        [Total acumulado receita]
			    )
			
			// 2. DEFINIR O DENOMINADOR CORRETO BASEADO NO NÍVEL DA HIERARQUIA
			VAR Denominador =
			    SWITCH (
			        TRUE (),
			        // Se a linha for um detalhe de 4º nível (ex: "RECEITAS DE FATURAS..."),
			        // o denominador é o total do seu pai de 3º nível ("...PRESTAÇÃO DE SERVIÇOS")
			        ISINSCOPE ( 'dPlanoContas'[Hierarchy_L4] ),
			        CALCULATE ( [Total acumulado receita], REMOVEFILTERS ( 'dPlanoContas'[Hierarchy_L4] ) ),
			        
			        // Se a linha for um subtotal de 3º nível (ex: "...PRESTAÇÃO DE SERVIÇOS"),
			        // o denominador é o total do seu pai de 2º nível ("RECEITAS OPERACIONAIS")
			        ISINSCOPE ( 'dPlanoContas'[Hierarchy_L3] ),
			        CALCULATE ( [Total acumulado receita], REMOVEFILTERS ( 'dPlanoContas'[Hierarchy_L3] ) ),
			        
			        // Se a linha for um subtotal de 2º nível (ex: "RECEITAS OPERACIONAIS"),
			        // o denominador é o total do seu pai de 1º nível ("RECEITAS")
			        ISINSCOPE ( 'dPlanoContas'[Hierarchy_L2] ),
			        CALCULATE ( [Total acumulado receita], REMOVEFILTERS ( 'dPlanoContas'[Hierarchy_L2] ) ),
			        
			        // Se a linha for um subtotal de 1º nível (ex: "RECEITAS"),
			        // o denominador é ele mesmo para resultar em 100%
			        ISINSCOPE ( 'dPlanoContas'[Hierarchy_L1] ), [Total acumulado receita]
			    )
			
			// 3. CALCULAR O RESULTADO FINAL
			RETURN
			    // Evita erro de divisão por zero e não mostra % em linhas vazias
			    IF ( NOT ISBLANK ( Denominador ), DIVIDE ( Numerador, Denominador, 0 ) )
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Posição Acumulada
		lineageTag: a9612cea-f2e6-49f8-9de7-8974f6cc5edb

