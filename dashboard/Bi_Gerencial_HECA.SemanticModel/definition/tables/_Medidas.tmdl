	measure 'Saldo Compromissado' = [Receita Diferida Compromissado] - [Total Despesa Compromissado]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: _Posição Compromissado
		lineageTag: 70d77d17-8c09-4a39-8088-a6cba23bb1fa

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Saldo Total' = [Saldo Efetuado] + [Saldo Compromissado]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Posição Acumulada
		lineageTag: fe29bd97-f7dd-458f-a00b-e6e8dcbba7a0

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure %Resultado = ```
			
			VAR TotalReceita = 
			    CALCULATE(
			        [Total acumulado receita], 
			        ALL(dPlanoContas), -- Removes the row context (allows us to see the total)
			        LEFT(dPlanoContas[COD_CONTA], 1) = "1" -- Filters only Revenue
			    )
			
			VAR TotalDespesa = 
			    CALCULATE(
			        [Total acumulado receita], 
			        ALL(dPlanoContas), 
			        LEFT(dPlanoContas[COD_CONTA], 1) = "2" -- Filters only Expenses
			    )
			
			VAR Saldo = TotalReceita - TotalDespesa -- (A - B)
			
			RETURN 
			    DIVIDE(Saldo, TotalReceita) -- (A - B) / A
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 62ed420f-e8d9-4c34-826c-1619af578796

