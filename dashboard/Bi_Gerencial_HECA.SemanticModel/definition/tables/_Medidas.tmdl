	measure 'Saldo Movimento efetuado' = [Total Receita Efetuado] - [Total Despesa Efetuado]
		lineageTag: a32362b8-d962-4428-81f5-c2e48f4a18e0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Fluxo Caixa Efetuado Acumulado' = ```
			
			-- Capturamos os valores da linha atual para servir de ponto de parada do acúmulo
			VAR DataAtual = MAX('fct_gerencial'[DT.Competencia])
			VAR RI_Atual = MAX('fct_gerencial'[RI])
			VAR DocAtual = MAX('fct_gerencial'[NUMDOC])
			
			RETURN
			CALCULATE(
			    [Saldo Movimento efetuado],
			    FILTER(
			        ALLSELECTED(
			            'fct_gerencial'[FORNECEDOR/CLIENTE],
			            'fct_gerencial'[HISTORICO],
			            'fct_gerencial'[PLANO DE CONTA],
			            'fct_gerencial'[PLANO DE CONTA_1],
			            'fct_gerencial'[OP.],
			            'fct_gerencial'[OP._2],
			            'fct_gerencial'[EMPRESA RECBTO/PAGTO],
			            'fct_gerencial'[NUMDOC],
			            'fct_gerencial'[RI],
			            'fct_gerencial'[DT.Competencia]
			        ),
			        -- Lógica de comparação para acumular:
			        'fct_gerencial'[DT.Competencia] < DataAtual || 
			        ('fct_gerencial'[DT.Competencia] = DataAtual && 'fct_gerencial'[RI] < RI_Atual) ||
			        ('fct_gerencial'[DT.Competencia] = DataAtual && 'fct_gerencial'[RI] = RI_Atual && 'fct_gerencial'[NUMDOC] <= DocAtual)
			    )
			)
			```
		lineageTag: e25b3398-c1fd-4bfc-97da-1aa98323b47b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Saldo Movimento Compromissado' = [Total Receita Compromissado] - [Total Despesa Compromissado]
