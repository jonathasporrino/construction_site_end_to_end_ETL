model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	discourageImplicitMeasures
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table fct_lancamento
ref table fct_posicao_economica_mensal
ref table dim_obra
ref table dim_conta
ref table dim_operacao
ref table dim_date
ref table Contraparte
ref table 'Empresa Pagto'
ref table Socio
ref table bridge_obra_socio
ref table seg_acesso_usuario
ref table _Medidas

ref role 'Unidade de Negocio'
