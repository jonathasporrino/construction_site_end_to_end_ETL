		dataType: string
		summarizeBy: none
		sourceColumn: historico

	column tipo_titulo
		dataType: string
		summarizeBy: none
		sourceColumn: tipo_titulo

	column status
		dataType: string
		summarizeBy: none
		sourceColumn: status

	column is_dre
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_dre

