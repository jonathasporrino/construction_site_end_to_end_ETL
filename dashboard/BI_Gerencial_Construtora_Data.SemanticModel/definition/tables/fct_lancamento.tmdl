	column apconta
		dataType: string
		summarizeBy: none
		sourceColumn: apconta

	column valor_previsto
		dataType: decimal
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		summarizeBy: sum
		sourceColumn: valor_previsto

	column valor_compromissado
		dataType: decimal
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		summarizeBy: sum
		sourceColumn: valor_compromissado

	column valor_efetuado
		dataType: decimal
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		summarizeBy: sum
		sourceColumn: valor_efetuado

	column valor_total
		dataType: decimal
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		summarizeBy: sum
		sourceColumn: valor_total

	column tx_adm_prev
		dataType: decimal
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		summarizeBy: sum
		sourceColumn: tx_adm_prev

	column tx_adm_comp
		dataType: decimal
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		summarizeBy: sum
