				    Typed = Table.TransformColumnTypes(Source, {{"obra_key", Int64.Type}, {"numero_obra", Int64.Type}, {"descricao_obra", type text}, {"tipo_obra", type text}, {"tipo_cliente", type text}, {"grupo", type text}, {"unidade_negocio", type text}, {"controle", type text}, {"gerente", type text}, {"uf", type text}, {"cliente", type text}, {"pct_empresa_parceira", Currency.Type}, {"valor_contrato", Currency.Type}, {"pct_fisico_executado", Currency.Type}, {"credito_inss", type text}, {"contas_inss", type text}, {"dt_inicio", type datetime}, {"dt_fim", type datetime}, {"is_ativa", type logical}, {"is_centro_administrativo", type logical}})
				in
				    Typed

